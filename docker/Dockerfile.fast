# Elmo Custom Web Builder
FROM node:24-alpine AS base
RUN corepack enable pnpm

FROM base AS builder
WORKDIR /app

# 拷贝完整修改后的源码（包含 packages/lib/src/providers/registry/openai-api.ts 修复）
COPY . .

# 快速安装依赖
RUN pnpm install --no-frozen-lockfile

# 构建 Web 前端与服务端产物
ARG DEPLOYMENT_MODE=local
ARG VITE_DEPLOYMENT_MODE=${DEPLOYMENT_MODE}
ENV VITE_DEPLOYMENT_MODE=${VITE_DEPLOYMENT_MODE}
RUN pnpm --filter @workspace/web build

# Runner stage
FROM base AS web
WORKDIR /app

ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 elmo

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

COPY --from=builder --chown=elmo:nodejs /app/apps/web/.output ./.output

USER elmo
EXPOSE 3000
ENV PORT=3000
ENV HOST="0.0.0.0"

ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", ".output/server/index.mjs"]
